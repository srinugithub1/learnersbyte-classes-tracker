# Copy this file to ".env" and fill in the values.
# Supabase project "Students Tracker" -> Project Settings -> API

# "Project URL"
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The "service_role" secret, NOT the anon/public key. It bypasses Row Level
# Security, so it must stay on the server. .env is git-ignored.
SUPABASE_SERVICE_KEY=paste-your-service_role-key-here

PORT=3000

# The wall clock your classes run on, as an IANA timezone name.
#
# Class times, the 15-minute grace period and exam windows are all converted to
# this zone explicitly (zone.js), so the HOST's own timezone is irrelevant —
# Vercel runs in UTC and still gets Indian class times right. Do not try to set
# TZ on Vercel; it is a reserved variable name there.
APP_TIMEZONE=Asia/Calcutta


# The first teacher/admin account. Created automatically the first time the
# server starts on an empty database. Change the password after logging in.
ADMIN_EMAIL=teacher@udayan.local
ADMIN_PASSWORD=Teach1234
ADMIN_NAME=Class Teacher

# Optional: a fixed secret for signing login cookies. If left unset, one is
# derived from the service key, so sessions survive restarts either way.
# SESSION_SECRET=

# Optional: set to "false" to stop the forgot-password screen from showing the
# reset link on-page (it is always printed to the server console).
# SHOW_RESET_LINK=false

# Daily attendance marking. Set to false to hide the Attendance tab from
# students and refuse marks at the API. Teachers can still record and
# correct any day. Set it back to true to switch marking on again.
ATTENDANCE_ENABLED=true
